# Copy this file to .env.local in your project root and fill in your own values.
# Never commit the real .env.local. The scripts read these names and never print the values.
# One KEY=value per line, with no spaces around the = (the shell and the Python scripts both read this file).

# Mail API (monitor.py and mailer.py send and read mail through it)
COMPOSIO_API_KEY=YOUR_API_KEY

# Payments (monitor.py reads recent charges; start_wave.sh reads the account settings).
# Use a restricted, read-only key if your provider offers one.
STRIPE_SECRET_KEY=YOUR_API_KEY

# Optional: marketplace sales check in monitor.py. Leave the placeholder value and the check is skipped.
MARKETPLACE_TOKEN=YOUR_API_KEY

# Optional: only the leads-builder brief (run/briefs/B1_leads_builder.md) uses this one.
COMPANIES_HOUSE_KEY=YOUR_API_KEY
